<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://android.com">

    <!-- Mandatory authorization permission to read/write matrix frames -->
    <uses-permission android:name="com.nothing.ketchum.permission.ENABLE"/>

    <application
        android:allowBackup="true"
        android:label="Dragon Toy"
        android:supportsRtl="true">

        <!-- Mandatory SDK licensing metadata to permit service parsing -->
        <meta-data android:name="NothingKey" android:value="test" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".DragonToyService"
            android:exported="true">
            <intent-filter>
                <!-- Uppercase TOY action matches system framework hooks -->
                <action android:name="com.nothing.glyph.TOY" />
            </intent-filter>

            <!-- Metadata mapping using hardcoded assets to circumvent link dependencies -->
            <meta-data 
                android:name="com.nothing.glyph.toy.name" 
                android:value="Dragon Toy" /> 
            
            <meta-data 
                android:name="com.nothing.glyph.toy.image" 
                android:resource="@mipmap/ic_launcher" />

            <!-- Integration hooks for action behaviors and AOD screen parsing -->
            <meta-data android:name="com.nothing.glyph.toy.longpress" android:value="1" />
            <meta-data android:name="com.nothing.glyph.toy.aod_support" android:value="1" />
        </service>
    </application>
</manifest>
