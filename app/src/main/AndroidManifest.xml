<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://android.com">

    <!-- Permission block explicitly declared with explicit android:name namespace -->
    <uses-permission android:name="com.nothing.ketchum.permission.ENABLE" />

    <application
        android:allowBackup="true"
        android:label="Dragon Toy"
        android:supportsRtl="true">

        <!-- Mandatory SDK authentication block -->
        <meta-data 
            android:name="NothingKey" 
            android:value="test" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".DragonToyService"
            android:exported="true">
            
            <intent-filter>
                <action android:name="com.nothing.glyph.TOY" />
            </intent-filter>

            <!-- Correctly named layout metadata parameters -->
            <meta-data 
                android:name="com.nothing.glyph.toy.name" 
                android:value="Dragon Toy" /> 
            
            <meta-data 
                android:name="com.nothing.glyph.toy.image" 
                android:resource="@mipmap/ic_launcher" />

            <!-- Behavioral settings hooks -->
            <meta-data 
                android:name="com.nothing.glyph.toy.longpress" 
                android:value="1" />
            
            <meta-data 
                android:name="com.nothing.glyph.toy.aod_support" 
                android:value="1" />
        </service>
    </application>
</manifest>
