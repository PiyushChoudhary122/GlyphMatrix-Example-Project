<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 1. MANDATORY PERMISSION ADDED -->
    <uses-permission android:name="com.nothing.ketchum.permission.ENABLE"/>

    <application
        android:allowBackup="true"
        android:label="Dragon Toy"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".DragonToyService"
            android:exported="true">
            <intent-filter>
                <!-- 2. CHANGED TO CAPITAL 'TOY' -->
                <action android:name="com.nothing.glyph.TOY" />
            </intent-filter>
<!-- Temporary quick-fix instead of custom resources -->
<meta-data 
    android:name="com.nothing.glyph.toy.name" 
    android:value="Dragon Toy" /> <!-- Hardcoded text directly -->

<meta-data 
    android:name="com.nothing.glyph.toy.image" 
    android:resource="@mipmap/ic_launcher" /> <!-- Uses your default app icon -->
 <!-- Place a preview image in your drawable folder -->

            <!-- Optional behaviors -->
            <meta-data android:name="com.nothing.glyph.toy.longpress" android:value="1" />
            <meta-data android:name="com.nothing.glyph.toy.aod_support" android:value="1" />
        </service>
    </application>
</manifest>
